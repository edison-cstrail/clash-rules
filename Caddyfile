{$DOMAIN} {
    @subscription {
        method GET HEAD
        path /{$SUB_TOKEN}/clash.yaml
    }
    handle @subscription {
        # Replace the entire query so public requests cannot select other files or URLs.
        rewrite * /getprofile?name=private/profile.ini&token={$SUB_TOKEN}
        header Cache-Control "no-store"
        reverse_proxy subconverter:25500
    }
    handle {
        respond "Not Found" 404
    }
}
